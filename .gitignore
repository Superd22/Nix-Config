# docs/ itself is tracked; research/ holds local reading notes that are not.
docs/research/
.serena
.vscode

# JetBrains project dirs. DataGrip recreates one wherever it has a project
# open, which is how modules/config/datagrip and modules/darwin/home/datagrip
# ended up in this repo. Datasources are declared in nix now (#7).
.idea/

# Claude Code agent worktrees, created in whatever repo it is run in.
.claude/

# wm's claude module (wemaintain/devenv) links its plugin into
# ~/.claude/skills/wm-devenv on every repo entry. ~/.claude/skills is a live
# symlink into modules/config/claude/skills, so the link lands here. It points
# into the store and is recreated on the next entry.
modules/config/claude/skills/wm-devenv
